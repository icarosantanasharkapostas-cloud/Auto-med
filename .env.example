# ===================================================================
# .env.example — MODELO de configuração (pode ir pro GitHub)
# ===================================================================
# 📋 Como usar:
#   1. Faça uma CÓPIA deste arquivo e renomeie para ".env"
#      (no terminal:  cp .env.example .env )
#   2. Troque os valores de exemplo abaixo pelos SEUS valores reais.
#   3. NUNCA envie o arquivo ".env" para o GitHub! (ele já está
#      protegido pelo .gitignore)
# ⚠️ Os valores abaixo são apenas EXEMPLOS. Não são reais!
# ===================================================================

# ----- 🗄️ Banco de Dados -----
# Onde os dados do bot ficam salvos.
# Para testes no seu PC, pode usar SQLite (mais simples):
#   DATABASE_URL=sqlite:///./mediacao.db
# Para PRODUÇÃO (recomendado), use um PostgreSQL:
DATABASE_URL=postgresql://usuario:senha@localhost/mediacaobot

# ----- 👤 Login da Dashboard (painel de administração) -----
# Usuário e senha para entrar no painel web do bot.
# TROQUE por uma senha forte antes de colocar no ar!
ADMIN_USERNAME=admin
ADMIN_PASSWORD=troque_por_uma_senha_bem_forte

# ----- 🔐 Segurança (JWT - token de login) -----
# SECRET_KEY: chave secreta usada para proteger os logins.
# Gere uma chave longa e aleatória. Dica para gerar no terminal:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=coloque_aqui_uma_chave_longa_e_aleatoria
# ALGORITHM: algoritmo de criptografia (pode deixar HS256).
ALGORITHM=HS256
# Quanto tempo (em minutos) o login fica válido. 1440 = 24 horas.
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ----- 🌐 Servidor da API -----
# Endereço e porta onde a aplicação vai rodar.
# 0.0.0.0 significa "aceitar conexões de qualquer lugar".
API_HOST=0.0.0.0
API_PORT=8000
